library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity servomoteur_avalon is
    port (
        -- Interface Avalon-MM Slave
        clk        : in  std_logic;
        reset_n    : in  std_logic;
        chipselect : in  std_logic;                    -- Sélection du périphérique
        write_n    : in  std_logic;                    -- Write Enable (Actif bas)
        writedata  : in  std_logic_vector(31 downto 0);-- Données venant du Nios II (32 bits)
        
        -- Interface Conduit (Vers le servomoteur physique)
        commande   : out std_logic
    );
end entity;

architecture rtl of servomoteur_avalon is

    -- 1. Déclaration du composant interne (votre code)
    component servomoteur is
        port (
            clk      : in  std_logic;
            reset_n  : in  std_logic;
            position : in  std_logic_vector(7 downto 0);
            commande : out std_logic
        );
    end component;

    -- 2. Registre interne pour stocker la position (8 bits)
    signal reg_position : std_logic_vector(7 downto 0);

begin

    -- 3. Processus d'écriture sur le Bus Avalon
    -- Le processeur écrit 32 bits, mais nous n'en gardons que 8.
    process(clk, reset_n)
    begin
        if reset_n = '0' then
            reg_position <= (others => '0'); -- Position 0 par défaut au reset
        elsif rising_edge(clk) then
            
            -- Condition d'écriture Avalon :
            -- Chipselect doit être à '1' (ce périphérique est choisi)
            -- Write_n doit être à '0' (ordre d'écriture actif bas)
            if chipselect = '1' and write_n = '0' then
                -- On récupère les 8 bits de poids faible (LSB) du bus de données
                reg_position <= writedata(7 downto 0);
            end if;
            
        end if;
    end process;

    -- 4. Instanciation du cœur servomoteur
    u0_servo : servomoteur
        port map (
            clk      => clk,
            reset_n  => reset_n,
            position => reg_position,  -- On connecte notre registre interne
            commande => commande       -- On sort le signal PWM vers l'extérieur
        );

end architecture;